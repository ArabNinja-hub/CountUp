# ---------------------------------------------------------------------------
# Countup is a static Vite build. Only the local Express server (server.ts) and
# the Vite config read env vars — no API keys are needed to run the app.
# ---------------------------------------------------------------------------

# PORT: port used by `npm run dev` / `npm run start`. Defaults to 3000.
PORT="3000"

# VITE_BASE_PATH: subpath the app is built and served from. Read at build time by
# vite.config.ts and by the Express server (both import base-path.ts). GitHub Pages
# hosts project sites at /<repo>/, so the default matches this repo; use '/' when
# hosting a custom domain from the site root. A build published with the wrong value
# shows a blank screen, because the asset URLs will not carry the needed prefix.
VITE_BASE_PATH="/CountUp/"

# Subscription-payment instructions and platform identity are configured as Firebase
# Functions secrets, not Vite/browser variables. See README.md → Manual payment
# configuration and Platform owner access. Do not put owner email or receiving numbers here.

# ---------------------------------------------------------------------------
# M0/M1 backend foundation (apps/api) — deployment identity only.
# Business settings live in the PostgreSQL `system_config` table, NOT here.
# ---------------------------------------------------------------------------

# NODE_ENV: development | test | production. The migration CLI refuses to run
# when this is "production"; M0/M1 is not a production cutover.
NODE_ENV="development"

# LOG_LEVEL: debug | info | warn | error. Defaults to info.
LOG_LEVEL="info"

# APP_VERSION: reported by /health/live. Defaults to 0.1.0.
APP_VERSION="0.1.0"

# DATABASE_URL: PostgreSQL connection string for a NON-PRODUCTION database.
# Used only by the migration CLI (`npm run db:migrate` / `db:migrate:down` /
# `db:status`) and by the optional API readiness probe. NEVER put a production
# connection string in this file. Leave unset to boot the API without a database.
# The test suite NEVER reads this variable: it always uses a fresh in-memory
# PGlite instance, so no test can reach a real database.
# DATABASE_URL="postgresql://user:password@localhost:5432/countup_dev"

# MIGRATIONS_DIR: optional override for the SQL directory. Defaults to ./migrations.
# MIGRATIONS_DIR="./migrations"
