# ---------------------------------------------------------------------------
# CountUp — Browser & Local Server Environment Variables (.env.example)
# Copy to `.env.local` for local development or configure in Cloudflare Pages.
# NEVER place SUPABASE_SERVICE_ROLE_KEY, COUNTUP_PIN_PEPPER, or SMS API keys here!
# ---------------------------------------------------------------------------

# Local dev / preview server port (`npm run dev` / `npm start`)
PORT="3000"

# Base path the app is served from:
# - Use "/" on Cloudflare Pages / custom domain root (`npm run build:cloudflare` or `CF_PAGES=1`)
# - Defaults to "/CountUp/" when unset outside Cloudflare Pages (for GitHub Pages)
VITE_BASE_PATH="/"

# Public Supabase project URL & anon key (safe for browser; RLS + session binding enforced)
# Note: Setting VITE_SUPABASE_URL at build time also pins Content-Security-Policy `connect-src`
# in `dist/_headers` to this exact Supabase project host (HTTPS + WSS).
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# Optional public Cloudflare Turnstile site key for SMS OTP anti-bot verification
VITE_TURNSTILE_SITE_KEY=""
