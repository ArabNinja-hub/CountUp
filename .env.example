# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================
# LIPILA OFFICIAL PAYMENT API CONFIGURATION (ZAMBIA)
# Docs: https://docs.lipila.io / https://docs.lipila.dev
# ==============================================================
# Environment: 'sandbox' (testing) or 'production' (live)
# - Sandbox endpoint:    https://api.lipila.dev/api/v1
# - Production endpoint: https://blz.lipila.io/api/v1
LIPILA_ENVIRONMENT="sandbox"

# Lipila API Key:
# - In Sandbox, keys start with "lsk_" (e.g. lsk_test_...)
# - In Production, keys start with "lpk_" (e.g. lpk_live_...)
LIPILA_API_KEY=""

# Lipila Merchant Wallet / Till ID:
# Generated when creating your merchant account on dashboard.lipila.io
LIPILA_WALLET_ID=""

# Optional Webhook Verification Secret
LIPILA_WEBHOOK_SECRET=""

# Platform Owner
PLATFORM_OWNER_EMAIL="ronisherbwalya@gmail.com"
