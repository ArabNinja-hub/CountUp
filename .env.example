# ---------------------------------------------------------------------------
# Countup is a static Vite build. Only the local Express server (server.ts) and
# the Vite config read env vars — no API keys are needed to run the app.
# ---------------------------------------------------------------------------

# PORT: port used by `npm run dev` / `npm run start`. Defaults to 3000.
PORT="3000"

# VITE_BASE_PATH: subpath the app is built and served from. Read at build time by
# vite.config.ts and by the Express server (both import base-path.ts). GitHub Pages
# hosts project sites at /<repo>/, so the default matches this repo; use '/' when
# hosting a custom domain from the site root. A build published with the wrong value
# shows a blank screen, because the asset URLs will not carry the needed prefix.
VITE_BASE_PATH="/CountUp/"

# NOTE: the Lipila Mobile Money server routes (LIPILA_*, APP_URL, PLATFORM_OWNER_EMAIL,
# GEMINI_API_KEY) were removed when the app became a static Pages deployment. Plan
# top-ups are handled out-of-band through the contact options in the Plan screen.
