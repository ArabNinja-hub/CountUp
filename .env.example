# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================
# PESAPAL API 3.0 OFFICIAL PAYMENT GATEWAY CONFIGURATION
# Docs: https://developer.pesapal.com / https://developer.pesapal.com/plans
# ==============================================================
# Environment: 'sandbox' (testing) or 'production' (live)
# - Sandbox endpoint:    https://cybqa.pesapal.com/pesapalv3
# - Production endpoint: https://pay.pesapal.com/v3
PESAPAL_ENVIRONMENT="sandbox"

# Pesapal Consumer Key:
# Obtain from your Pesapal merchant / developer dashboard:
# Sandbox: https://cybqa.pesapal.com
# Live:    https://www.pesapal.com
PESAPAL_CONSUMER_KEY=""

# Pesapal Consumer Secret:
PESAPAL_CONSUMER_SECRET=""

# Pesapal IPN ID (Optional, server will auto-register if blank):
PESAPAL_IPN_ID=""

# Platform Owner
PLATFORM_OWNER_EMAIL="ronisherbwalya@gmail.com"
