rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Sign-in is phone + PIN only, which gives every device an anonymous Firebase
    // session (no email claim). Platform ownership is therefore granted by the
    // `admins` registry: create admins/<uid> for the owner account in the Firebase
    // console. Nothing is granted by email or phone number.
    function isPlatformAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isShopOwner(shopId) {
      return isSignedIn() && (
        request.auth.uid == shopId ||
        (exists(/databases/$(database)/documents/shops/$(shopId)) &&
         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid)
      );
    }

    // A PIN is the only credential a shop has, so it is always exactly 4 digits.
    function isFourDigitPin(value) {
      return value is string && value.matches('^[0-9]{4}$');
    }

    // Connectivity probe used by the app on start. It is read-only: nothing in
    // the app writes it, so writing is denied rather than left open to any
    // signed-in device.
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Admins registry — the only grant of platform-owner access.
    // A device may only ask "am I an admin?" about itself; it may not read or
    // list the registry, which would hand out the owner's uid to any user.
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list: if isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    // Shops
    match /shops/{shopId} {
      // Platform admin can read all shops; shop owner can read their own shop
      allow get: if isShopOwner(shopId) || isPlatformAdmin();
      allow list: if isPlatformAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      // Create: a new shop belongs to the device that created it, holds a 4-digit
      // PIN, and starts on the free trial. It cannot be created already paid,
      // already deactivated, or with the trial end and plan expiry disagreeing.
      allow create: if isSignedIn() && (
        isPlatformAdmin() || (
          request.resource.data.ownerUid == request.auth.uid &&
          isFourDigitPin(request.resource.data.pin) &&
          request.resource.data.planStatus == 'trial' &&
          request.resource.data.planType == 'trial' &&
          request.resource.data.isDeactivated == false &&
          request.resource.data.planExpiryDate == request.resource.data.trialEndsAt
        )
      );

      // Update: a shop may change nothing about itself except its PIN. Plan
      // status, plan expiry and the deactivation flag belong to the platform
      // owner, so a shop cannot extend its own subscription or un-suspend itself
      // from the browser console. Everything else (records, credit balances) is
      // stored in the subcollections below.
      allow update: if isPlatformAdmin() || (
        isShopOwner(shopId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        isFourDigitPin(request.resource.data.pin) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin'])
      );

      // Delete: the shop owner can permanently delete their own shop and records
      // (backs the deletion right promised in the Privacy Policy).
      allow delete: if isShopOwner(shopId) || isPlatformAdmin();

      // Subcollections
      match /items/{itemId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }

      match /sales/{saleId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }

      match /customers/{customerId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }

      match /credit_payments/{paymentId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }

      match /expenses/{expenseId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }
    }
  }
}
