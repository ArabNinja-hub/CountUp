rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Global Safety Net (Catch-all default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Path Variable & Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Platform Administrator Check with Anti-Spoofing Guard
    function isPlatformAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "ronisherbwalya@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Master Gate (Relational Sync)
    function isShopOwner(shopId) {
      return isSignedIn() && (
        request.auth.uid == shopId ||
        (exists(/databases/$(database)/documents/shops/$(shopId)) &&
         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid)
      );
    }

    // Pillar 2: Validation Blueprints
    function isValidShop(data) {
      return data.keys().hasAll(['name', 'ownerPhone', 'ownerUid', 'planStatus']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.ownerPhone is string && data.ownerPhone.size() <= 30 &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.planStatus in ['trial', 'active', 'grace', 'expired'];
    }

    function isValidItem(data) {
      return data.keys().hasAll(['name', 'buyingPrice', 'sellingPrice', 'quantity', 'lowStockThreshold']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.buyingPrice is number && data.buyingPrice >= 0 &&
        data.sellingPrice is number && data.sellingPrice >= 0 &&
        data.quantity is number &&
        data.lowStockThreshold is number;
    }

    function isValidSale(data) {
      return data.keys().hasAll(['totalAmount', 'paymentType', 'createdAt']) &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.paymentType in ['cash', 'momo', 'credit'] &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'totalOwed']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.totalOwed is number;
    }

    function isValidCreditPayment(data) {
      return data.keys().hasAll(['customerId', 'amount', 'createdAt']) &&
        data.customerId is string && data.customerId.size() <= 128 &&
        data.amount is number && data.amount > 0 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['category', 'amount', 'createdAt']) &&
        data.category in ['rent', 'transport', 'restock', 'council_fee', 'helper_wage', 'other'] &&
        data.amount is number && data.amount > 0 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Test connection doc used for client connectivity verification
    match /test/connection {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Platform Admins Registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    // Shops Collection
    match /shops/{shopId} {
      allow get: if isValidId(shopId) && (isShopOwner(shopId) || isPlatformAdmin());
      allow list: if isPlatformAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isValidId(shopId) && isSignedIn() && isValidShop(incoming()) && (
        incoming().ownerUid == request.auth.uid || isPlatformAdmin()
      );

      allow update: if isValidId(shopId) && (
        isPlatformAdmin() || (
          isShopOwner(shopId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'ownerPhone', 'ownerEmail', 'pin', 'planStatus', 'planType',
            'trialEndsAt', 'planExpiryDate', 'isDeactivated', 'updatedAt', 'currency'
          ])
        )
      );

      allow delete: if isValidId(shopId) && isPlatformAdmin();

      // Subcollection: Items
      match /items/{itemId} {
        allow get, list: if isValidId(shopId) && (isShopOwner(shopId) || isPlatformAdmin());
        allow create: if isValidId(shopId) && isValidId(itemId) && (isShopOwner(shopId) || isPlatformAdmin()) && isValidItem(incoming());
        allow update: if isValidId(shopId) && isValidId(itemId) && (isShopOwner(shopId) || isPlatformAdmin()) && isValidItem(incoming());
        allow delete: if isValidId(shopId) && isValidId(itemId) && (isShopOwner(shopId) || isPlatformAdmin());
      }

      // Subcollection: Sales
      match /sales/{saleId} {
        allow get, list: if isValidId(shopId) && (isShopOwner(shopId) || isPlatformAdmin());
        allow create: if isValidId(shopId) && isValidId(saleId) && (isShopOwner(shopId) || isPlatformAdmin()) && isValidSale(incoming());
        allow update: if isValidId(shopId) && isValidId(saleId) && isPlatformAdmin();
        allow delete: if isValidId(shopId) && isValidId(saleId) && isPlatformAdmin();
      }

      // Subcollection: Customers
      match /customers/{customerId} {
        allow get, list: if isValidId(shopId) && (isShopOwner(shopId) || isPlatformAdmin());
        allow create: if isValidId(shopId) && isValidId(customerId) && (isShopOwner(shopId) || isPlatformAdmin()) && isValidCustomer(incoming());
        allow update: if isValidId(shopId) && isValidId(customerId) && (isShopOwner(shopId) || isPlatformAdmin()) && isValidCustomer(incoming());
        allow delete: if isValidId(shopId) && isValidId(customerId) && (isShopOwner(shopId) || isPlatformAdmin());
      }

      // Subcollection: Credit Payments
      match /credit_payments/{paymentId} {
        allow get, list: if isValidId(shopId) && (isShopOwner(shopId) || isPlatformAdmin());
        allow create: if isValidId(shopId) && isValidId(paymentId) && (isShopOwner(shopId) || isPlatformAdmin()) && isValidCreditPayment(incoming());
        allow update: if isValidId(shopId) && isValidId(paymentId) && isPlatformAdmin();
        allow delete: if isValidId(shopId) && isValidId(paymentId) && isPlatformAdmin();
      }

      // Subcollection: Expenses
      match /expenses/{expenseId} {
        allow get, list: if isValidId(shopId) && (isShopOwner(shopId) || isPlatformAdmin());
        allow create: if isValidId(shopId) && isValidId(expenseId) && (isShopOwner(shopId) || isPlatformAdmin()) && isValidExpense(incoming());
        allow update: if isValidId(shopId) && isValidId(expenseId) && (isShopOwner(shopId) || isPlatformAdmin()) && isValidExpense(incoming());
        allow delete: if isValidId(shopId) && isValidId(expenseId) && (isShopOwner(shopId) || isPlatformAdmin());
      }
    }
  }
}
