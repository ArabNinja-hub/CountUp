rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Only a server-issued custom claim grants platform authority. The claim can
    // be provisioned only by the Admin SDK after verifying the configured owner.
    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.platformAdmin == true;
    }

    function isShopOwner(shopId) {
      return isSignedIn() && (
        request.auth.uid == shopId ||
        (exists(/databases/$(database)/documents/shops/$(shopId)) &&
         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid)
      );
    }

    function isFourDigitPin(value) {
      return value is string && value.matches('^[0-9]{4}$');
    }

    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Retired client-side admin registry. Platform roles are custom claims only.
    match /admins/{adminId} {
      allow read, write: if false;
    }

    match /shops/{shopId} {
      allow get: if isShopOwner(shopId) || isPlatformAdmin();
      allow list: if isPlatformAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      // A shop may only be created as a free trial owned by the signed-in user.
      allow create: if isSignedIn() && (
        isPlatformAdmin() || (
          request.resource.data.ownerUid == request.auth.uid &&
          isFourDigitPin(request.resource.data.pin) &&
          request.resource.data.planStatus == 'trial' &&
          request.resource.data.planType == 'trial' &&
          request.resource.data.isDeactivated == false &&
          request.resource.data.planExpiryDate == request.resource.data.trialEndsAt &&
          request.resource.data.trialEndsAtMs is int &&
          request.resource.data.planExpiryAtMs == request.resource.data.trialEndsAtMs &&
          request.resource.data.trialEndsAtMs <= request.time.toMillis() + 2592000000 &&
          request.resource.data.salesAccessUntilMs is int &&
          request.resource.data.salesAccessUntilMs == request.resource.data.trialEndsAtMs + 259200000
        )
      );

      // Client-side shop documents are not a route to extend, suspend, approve,
      // or otherwise edit entitlements. Those mutations run in Admin-SDK callables.
      allow update: if isPlatformAdmin() || (
        isShopOwner(shopId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        isFourDigitPin(request.resource.data.pin) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin'])
      );
      allow delete: if isShopOwner(shopId) || isPlatformAdmin();

      match /items/{itemId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }
      match /sales/{saleId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }
      match /customers/{customerId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }
      match /credit_payments/{paymentId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }
      match /expenses/{expenseId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }
      match /stock_movements/{movementId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }
      match /stock_conflicts/{conflictId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }
      match /sync_operations/{operationId} {
        allow read, write: if isShopOwner(shopId) || isPlatformAdmin();
      }
    }

    // Payment records are immutable to clients. A shop owner can only read
    // records with their own ownerUid; administrator operations use Functions.
    match /subscriptionPayments/{paymentId} {
      allow get, list: if isPlatformAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Reference locks are private integrity records and never client-readable.
    match /paymentReferenceLocks/{lockId} {
      allow read, write: if false;
    }

    // Audit history is visible only to the platform admin; all writes use Admin SDK.
    match /platformAudit/{auditId} {
      allow get, list: if isPlatformAdmin();
      allow create, update, delete: if false;
    }
  }
}
